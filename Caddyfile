{$DOMAIN} {
	encode zstd gzip

	# API, bot webhook and SMS ingest go to the Node server.
	@backend path /api/* /ingest/* /telegram/* /health
	handle @backend {
		reverse_proxy server:8787
	}

	# Everything else is the Mini App (SPA fallback).
	handle {
		root * /srv/miniapp
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}
