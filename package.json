{
  "name": "birr",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/** dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @birr/server db:generate",
    "db:migrate": "pnpm --filter @birr/server db:migrate",
    "seed": "pnpm --filter @birr/server seed"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  }
}
