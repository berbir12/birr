{
  "name": "@birr/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env ../../scripts/seed.ts",
    "start:prod": "tsx --env-file=../../.env src/index.ts",
    "backup": "tsx --env-file-if-exists=../../.env src/db/backup.ts"
  },
  "dependencies": {
    "@birr/core": "workspace:*",
    "@birr/parser": "workspace:*",
    "@birr/shared": "workspace:*",
    "@hono/node-server": "^2.1.11",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.48.0",
    "hono": "^4.13.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
