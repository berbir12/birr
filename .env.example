# Local development settings. Copy to .env (gitignored).
# Production values are set in Vercel → Project → Settings → Environment Variables (see DEPLOY.md).

# ---------- Server ----------
NODE_ENV=development
PORT=8787
# Bind address for local dev.
HOST=127.0.0.1
# Public base URL (webhooks, /connect). Production: https://<project>.vercel.app. Dev: your tunnel URL.
PUBLIC_URL=http://localhost:8787
# Where the Mini App is served. Production: same as PUBLIC_URL.
MINIAPP_URL=http://localhost:5173
# Serve the built Mini App from the Node server itself (not needed on Vercel or with `pnpm dev`).
SERVE_MINIAPP=false

# ---------- Telegram ----------
# From @BotFather. Locally, use a separate TEST bot, not the production one.
BOT_TOKEN=
# polling (local dev) | webhook (production on Vercel)
BOT_MODE=polling
# Random string Telegram echoes back on webhook calls. Required for webhook mode.
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric Telegram user ids allowed to use the bot/app. Get yours from @userinfobot.
ALLOWED_TELEGRAM_IDS=
# Reject Mini App initData older than this many seconds.
INITDATA_MAX_AGE_SECONDS=86400

# ---------- Database ----------
# Production: Supabase transaction-pooler URI (postgresql://postgres.<ref>:<password>@…pooler.supabase.com:6543/postgres).
# Unset: local PGlite database in data/pglite (no server needed).
DATABASE_URL=
# Optional: separate URL for migrations (e.g. Supabase session pooler, port 5432).
MIGRATION_DATABASE_URL=

# ---------- Privacy ----------
# 32 random bytes, base64. Encrypts raw SMS bodies at rest. Losing it = losing raw SMS text.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
TZ=Africa/Addis_Ababa

# ---------- SMS webhook ingestion ----------
INGEST_RATE_LIMIT_PER_MIN=30

# ---------- Cron (production) ----------
# Vercel sends "Authorization: Bearer <CRON_SECRET>" to /cron/daily.
CRON_SECRET=

# ---------- Optional LLM fallback for unknown SMS formats (off by default) ----------
LLM_FALLBACK_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Below this confidence a parse goes to the review queue.
LLM_MIN_CONFIDENCE=0.8

# ---------- Alerts (defaults; each is also editable in Settings) ----------
LARGE_TX_THRESHOLD_ETB=5000
LOW_BALANCE_THRESHOLD_ETB=500
DIGEST_TIME=21:00
