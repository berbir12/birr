[Unit]
Description=Birr SQLite backup
After=birr.service

[Service]
Type=oneshot
User=birr
Group=birr
WorkingDirectory=/opt/birr/apps/server
EnvironmentFile=/etc/birr/birr.env
ExecStart=/opt/birr/apps/server/node_modules/.bin/tsx src/db/backup.ts
StateDirectory=birr
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
